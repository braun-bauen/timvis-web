{
  "manifest_version": 3,
  "name": "Timvis",
  "version": "0.2.0",
  "description": "Limits time spent on configured domains per hour.",
  "permissions": ["storage", "tabs", "scripting", "permissions"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Timvis",
    "default_popup": "src/popup.html"
  }
}
